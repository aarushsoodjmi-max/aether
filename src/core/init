#!/bin/sh

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export TERM=linux

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

hostname aether

echo ""
echo "=============================="
echo "         AETHER OS"
echo "        Core v0.2"
echo "=============================="
echo ""
echo "Hostname: $(hostname)"
echo "Kernel: $(uname -r)"
echo "Userspace: BusyBox $(busybox | head -n 1 | cut -d ' ' -f 2)"
echo ""
echo "Aether system ready."
echo ""

exec /bin/setsid /bin/cttyhack /bin/sh
