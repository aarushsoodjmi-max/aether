#!/usr/bin/env python3
"""aether-import: inspect, validate and package existing Linux ELF software as .aether packages.

  aether-import inspect PATH [--root ROOT]
      For every ELF file under PATH print interpreter, DT_NEEDED, SONAME, RUNPATH and the newest
      GLIBC symbol version required. With --root, check that each dependency (and the interpreter)
      is resolvable inside ROOT using the dynamic loader's default search order. Exit 1 if not.

  aether-import package --name N --version V --tree DIR --out-dir DIR --pm aether-pm --key SECRET
                        [--libc glibc-2.39] [--depends 'pkg >= v']... [--summary TEXT]
                        [--root ROOT-TO-VALIDATE-AGAINST] [--ignore-needs SONAME]...
      Derives needs-soname / provides-soname from the ELF files in TREE (so external shared-library
      requirements are explicit), refuses packages that need a newer glibc than they declare,
      writes the package INFO, and builds + signs the .aether file with aether-pm.

Uses only readelf (binutils). Host-side tool: it never runs imported code and never touches a live system.
"""
import argparse, os, re, subprocess, sys

def readelf(args, path):
    return subprocess.run(["readelf"] + args + [path], capture_output=True, text=True).stdout

def is_elf(path):
    try:
        if os.path.islink(path) or not os.path.isfile(path): return False
        with open(path, "rb") as f: return f.read(4) == b"\x7fELF"
    except OSError: return False

def elf_info(path):
    dyn = readelf(["-d"], path); hdr = readelf(["-l", "-W"], path)
    needed = re.findall(r"\(NEEDED\)\s+Shared library: \[(.+?)\]", dyn)
    soname = re.findall(r"\(SONAME\)\s+Library soname: \[(.+?)\]", dyn)
    runpath = re.findall(r"\((?:RUNPATH|RPATH)\)\s+Library (?:runpath|rpath): \[(.+?)\]", dyn)
    m = re.search(r"Requesting program interpreter: (\S+?)\]", hdr)
    vers = [tuple(int(x) for x in v.split(".")) for v in re.findall(r"Name: GLIBC_(\d+(?:\.\d+)*)", readelf(["-V", "-W"], path))]
    return dict(path=path, needed=needed, soname=soname[0] if soname else None,
                runpath=runpath[0].split(":") if runpath else [], interp=m.group(1) if m else None,
                static=(not dyn.strip() or "no dynamic section" in dyn.lower()) and not m,
                glibc=max(vers) if vers else None)

def walk_elfs(tree):
    for d, _, files in os.walk(tree):
        for f in sorted(files):
            p = os.path.join(d, f)
            if is_elf(p): yield p

def default_dirs(root):
    dirs = ["usr/lib/x86_64-linux-gnu", "lib/x86_64-linux-gnu", "usr/lib", "lib", "usr/lib64", "lib64"]
    conf = os.path.join(root, "etc/ld.so.conf")
    return dirs

def resolve(root, soname, runpaths, origin_dir):
    cands = []
    for rp in runpaths:
        rp = rp.replace("$ORIGIN", origin_dir).replace("${ORIGIN}", origin_dir)
        cands.append(rp if rp.startswith(root) else os.path.join(root, rp.lstrip("/")))
    cands += [os.path.join(root, d) for d in default_dirs(root)]
    for c in cands:
        if os.path.exists(os.path.join(c, soname)): return os.path.join(c, soname)
    return None

def ver_str(t): return ".".join(map(str, t)) if t else "-"

def cmd_inspect(a):
    bad = 0; n = 0
    for p in ([a.path] if os.path.isfile(a.path) else walk_elfs(a.path)):
        if not is_elf(p): print(f"{p}: not an ELF file"); bad += 1; continue
        i = elf_info(p); n += 1
        kind = "static" if i["static"] else ("shared object" if i["soname"] else "executable")
        print(f"{p}\n  kind: {kind}   interp: {i['interp'] or '-'}   soname: {i['soname'] or '-'}   needs GLIBC <= {ver_str(i['glibc'])}")
        if i["needed"]: print("  needed: " + ", ".join(i["needed"]))
        if i["runpath"]: print("  runpath: " + ":".join(i["runpath"]))
        if a.root:
            root = os.path.abspath(a.root); origin = os.path.dirname(os.path.join(root, os.path.relpath(os.path.abspath(p), root))) if os.path.abspath(p).startswith(root) else os.path.dirname(p)
            if i["interp"] and not os.path.exists(os.path.join(root, i["interp"].lstrip("/"))):
                print(f"  MISSING interpreter {i['interp']} in {root}"); bad += 1
            for need in i["needed"]:
                r = resolve(root, need, i["runpath"], origin)
                print(f"  {'ok     ' if r else 'MISSING'} {need}" + (f" -> {os.path.relpath(r, root)}" if r else "")); bad += 0 if r else 1
    print(f"{n} ELF file(s) inspected, {bad} problem(s)")
    return 1 if bad else 0

def cmd_package(a):
    tree = os.path.abspath(a.tree); elfs = [elf_info(p) for p in walk_elfs(tree)]
    provides = sorted({i["soname"] for i in elfs if i["soname"]})
    needs = set()
    for i in elfs:
        for n in i["needed"]: needs.add(n)
        if i["interp"]: needs.add(os.path.basename(i["interp"]))
    # libraries shipped in the tree may also be reachable by file name only (no SONAME): count them as provided
    shipped = {os.path.basename(p) for d, _, fs in os.walk(tree) for f in fs for p in [os.path.join(d, f)]}
    needs = sorted(n for n in needs if n not in provides and n not in shipped and n not in (a.ignore_needs or []))
    gl = max([i["glibc"] for i in elfs if i["glibc"]], default=None)
    if a.libc and a.libc.startswith("glibc-") and gl:
        declared = tuple(int(x) for x in a.libc[6:].split("."))
        if gl > declared: print(f"error: {a.name} needs GLIBC_{ver_str(gl)} but declares {a.libc}", file=sys.stderr); return 1
    if gl and (not a.libc or a.libc == "none"):
        print(f"error: {a.name} links against glibc (needs GLIBC_{ver_str(gl)}); pass --libc glibc-X.Y", file=sys.stderr); return 1
    if a.root:
        for i in elfs:
            for need in i["needed"]:
                if need in provides or need in shipped: continue
                if not resolve(os.path.abspath(a.root), need, i["runpath"], os.path.dirname(i["path"])):
                    print(f"warning: {os.path.relpath(i['path'], tree)} needs {need}, not found in {a.root} (must be satisfied by a dependency)", file=sys.stderr)
    info = ["format 1", f"name {a.name}", f"version {a.version}", "arch x86_64", f"libc {a.libc or 'none'}"]
    if a.summary: info.append(f"summary {a.summary}")
    info += [f"depends {d}" for d in a.depends or []]
    info += [f"needs-soname {n}" for n in needs] + [f"provides-soname {p}" for p in provides]
    os.makedirs(a.out_dir, exist_ok=True)
    info_path = os.path.join(a.out_dir, f"{a.name}-{a.version}.INFO"); open(info_path, "w").write("\n".join(info) + "\n")
    out = os.path.join(a.out_dir, f"{a.name}_{a.version}_x86_64.aether")
    cmd = [a.pm, "build", info_path, tree, out] + (["--key", a.key] if a.key else [])
    r = subprocess.run(cmd, capture_output=True, text=True); sys.stdout.write(r.stdout); sys.stderr.write(r.stderr)
    if r.returncode == 0: print(f"  {len(elfs)} ELF files; needs-soname: {', '.join(needs) or '-'}; provides-soname: {len(provides)}; max GLIBC_{ver_str(gl)}")
    return r.returncode

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter); sp = ap.add_subparsers(dest="cmd", required=True)
    i = sp.add_parser("inspect"); i.add_argument("path"); i.add_argument("--root")
    p = sp.add_parser("package")
    for f in ("name", "version", "tree", "out-dir", "pm"): p.add_argument("--" + f, required=True)
    p.add_argument("--key"); p.add_argument("--libc"); p.add_argument("--summary"); p.add_argument("--depends", action="append"); p.add_argument("--root")
    p.add_argument("--ignore-needs", action="append", metavar="SONAME", help="do not declare this library as required (ONLY for intentionally broken test binaries)")
    a = ap.parse_args(); return cmd_inspect(a) if a.cmd == "inspect" else cmd_package(a)
if __name__ == "__main__": sys.exit(main())
